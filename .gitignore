node_modules/
dist/
.env
keys/
logs/
# Root-anchored: the runtime JSONL dir only. An unanchored data/ also
# matched src/data/ and kept the entire data layer out of the repo.
/data/
*.log
# Local Claude Code state stays out; the project settings file (permission rules) is committed.
.claude/*
!.claude/settings.json
# Live monitor snapshots are a local view, rewritten every 30 seconds; the
# scorecard (npm run score) is the committed record of each day's calls.
/docs/daily/*/live.txt
