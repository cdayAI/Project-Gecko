{
  "name": "gecko",
  "version": "0.2.0",
  "description": "Automated day-trading bot for US equities and 0DTE options (IBKR Client Portal API, Claude-assisted trade validation)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cdayAI/Project-Gecko.git"
  },
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "node --import tsx src/index.ts",
    "start": "node dist/index.js",
    "auth": "node --import tsx src/brokers/schwab/auth-cli.ts",
    "auth:ibkr": "node --import tsx src/brokers/ibkr/auth-cli.ts",
    "backtest": "node --import tsx src/backtest/backtest-cli.ts",
    "backtest:yahoo": "node --import tsx src/backtest/backtest-yahoo-cli.ts",
    "shadow": "node --import tsx src/shadow/shadow-cli.ts",
    "stress": "node --import tsx src/shadow/stress-tests.ts",
    "trace": "node --import tsx src/monitoring/trace-cli.ts",
    "report": "node --import tsx src/monitoring/daily-report-cli.ts",
    "research": "node --import tsx src/research/research-cli.ts",
    "research:selftest": "node --import tsx src/research/providers/webull/signer-selftest.ts",
    "scan:gap": "node --import tsx src/research/gap-scan.ts",
    "schwab:check": "node --import tsx src/research/gap-scan.ts --provider schwab --check-connection",
    "schwab:selftest": "node --import tsx src/brokers/schwab/windows-vault-selftest.ts && node --import tsx src/brokers/schwab/rest-readonly-selftest.ts",
    "universe:build": "node --import tsx src/research/universe.ts",
    "backtest:gapgo": "node --import tsx src/backtest/gap-and-go-cli.ts",
    "backtest:swing": "node --import tsx src/backtest/swing-cli.ts",
    "scan:swing": "node --import tsx src/research/swing-scan.ts"
  },
  "dependencies": {
    "dotenv": "^16",
    "ws": "^8"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/ws": "^8",
    "tsx": "^4",
    "typescript": "^5"
  }
}
